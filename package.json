{
  "name": "ai-frontend-guide-kit",
  "version": "1.3.0",
  "description": "Reusable-first UI component catalog and guided kit for AI frontend agents (26 sources, 3,858 entries, React/Vue/Svelte) with quality ranking, audits and optional local Laya ranking.",
  "repository": {
    "type": "git",
    "url": "https://github.com/urben88/ai-frontend-guide-kit.git"
  },
  "homepage": "https://github.com/urben88/ai-frontend-guide-kit#readme",
  "type": "module",
  "bin": {
    "ai-frontend-guide-kit": "./install.mjs"
  },
  "files": [
    "install.mjs",
    "ai-frontend-guide-kit",
    "skills",
    "README.md",
    "README.es.md"
  ],
  "scripts": {
    "validate": "node tools/validate.mjs",
    "build:index": "node tools/build-index.mjs",
    "build:kit": "node tools/build-kit.mjs",
    "refresh": "node tools/refresh.mjs",
    "prepublishOnly": "node tools/validate.mjs",
    "test": "node --test",
    "quality": "node tools/quality.mjs",
    "licenses": "node tools/check-licenses.mjs",
    "audit:categories": "node tools/audit-categories.mjs",
    "build:explorer": "node tools/build-explorer.mjs",
    "verify": "node tools/validate.mjs && node tools/build-kit.mjs && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
